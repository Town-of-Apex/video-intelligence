# Copy to .env and adjust if needed.

# Transcript chunking (used by chunk.py and main.py)
CHUNK_TARGET_SECONDS=120
CHUNK_OVERLAP_SECONDS=15

# SharePoint stream deep-links (sharepoint_nav.py)
SHAREPOINT_HOST=apexncorg.sharepoint.com
SHAREPOINT_SITE_NAME=TOAInnovations
SHAREPOINT_DOCUMENT_LIBRARY=Shared Documents
SHAREPOINT_VIDEO_FOLDER=Project Resources/Training Intelligence/Videos

# Manual transcriber web app (docker compose / web_app.py)
# TRANSCRIBER_PORT=8081
# WHISPER_MODEL=tiny.en
# MAX_UPLOAD_BYTES=4294967296
