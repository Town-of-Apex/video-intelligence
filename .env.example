# Copy to .env and adjust if needed.
POSTGRES_HOST=localhost
POSTGRES_PORT=5431
POSTGRES_DB=training_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Transcript chunking (used by chunk.py and main.py)
CHUNK_TARGET_WORDS=200
CHUNK_OVERLAP_WORDS=50

# RAG retrieval tuning (used by database.py search and openwebui_rag_poc.py)
RAG_TOP_K=5
RAG_FETCH_K=15
ENABLE_HYBRID_SEARCH=true
ENABLE_QUERY_EXPANSION=true
VECTOR_WEIGHT=0.65
TEXT_WEIGHT=0.20
TITLE_WEIGHT=0.15

# OpenWebUI pipe inference (ollama | openai | openrouter)
CHAT_BACKEND=openai
EMBEDDING_BACKEND=openai
CHAT_API_KEY=
EMBEDDING_API_KEY=
APP_NAME=Video Intelligence RAG
APP_URL=http://localhost
LLAMA_HOST=http://localhost:11434
LLAMA_MODEL=gemma-4-E2B.gguf
EMBEDDING_HOST=http://localhost:11435
EMBEDDING_MODEL=nomic-embed-text-v1.5.gguf
